<Project Sdk="Microsoft.NET.Sdk">

  <!-- Como rodar:  dotnet test tests\LayoutParserApi.Tests\LayoutParserApi.Tests.csproj

       Este projeto NÃO está em LayoutParserApi.sln de propósito. Na raiz do repo há um .sln e um
       .csproj, e o MSBuild resolve `dotnet build` sem argumento pela SOLUTION — o deploy.yml roda
       exatamente isso. Incluir os testes na .sln faria o deploy de produção passar a restaurar
       xUnit e compilar testes, e uma falha de restore ali quebraria o deploy. Entrar na .sln e
       adicionar `dotnet test` ao CI é decisão de @lp-devops. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Sem apphost: evita o erro de CreateAppHost em diretório temporário/máquina de build
         (armadilha conhecida desta máquina, ver harness de QA). O runner do xUnit não precisa
         do executável nativo. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- A API é um projeto Web (Microsoft.NET.Sdk.Web); o FrameworkReference do
         Microsoft.AspNetCore.App flui por aqui, então os testes enxergam ILogger/IConfiguration
         sem PackageReference extra. -->
    <ProjectReference Include="..\..\LayoutParserApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parser de linha de comando do runner low-code, compilado TAMBÉM aqui (link, não cópia).

         Por que link e não ProjectReference: o runner é net481/x86 (o stack Sysmiddle é 32-bit —
         ver o comentário do PlatformTarget no .csproj dele) e referenciá-lo de um projeto net10.0
         não é possível. O arquivo é puro (só System/System.Collections.Generic, com #nullable
         disable no topo para compilar idêntico nos dois targets), então o que roda no teste é
         exatamente o código que roda no .exe — não uma cópia que pode divergir. -->
    <Compile Include="..\..\tools\LowCodeRunner\RunnerArgs.cs"
             Link="Transformation\RunnerArgs.cs" />

    <!-- Mesmo raciocínio: as regras de documento portadas do MappersHelper (declaração XML e
         pós-processamento NF-e) são puras (System.Xml apenas), então o que a suíte exercita é
         exatamente o que roda no .exe. É aqui que a divergência entre ExecuteMappingDocumentById e
         ExecuteMappingDocument (docs/architecture/decisao-remover-dependencia-appconnector.md §3)
         deixa de ser comentário e vira invariante travada. -->
    <Compile Include="..\..\tools\LowCodeRunner\SysmiddleDocumentRules.cs"
             Link="Transformation\SysmiddleDocumentRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
