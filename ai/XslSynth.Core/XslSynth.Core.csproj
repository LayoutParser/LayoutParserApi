<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>XslSynth.Core</AssemblyName>
    <RootNamespace>XslSynth</RootNamespace>
    <!-- Números/comparações XPath independem de cultura (mesma config do CLI standalone). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Classlib extraída de ai/XslSynth (Core/+Synthesis/+Model/) para ser reaproveitada tanto
      pelo CLI standalone (ai/XslSynth) quanto pelo serviço novo dentro da API
      (Services/Transformation/Ai), sem duplicar o loop RAG (RepairOrchestrator).
      Ver docs/architecture/pathway-ia-execute-candidates.md §4.1, opção (a).
      100% .NET puro — sem dependência de cripto Sysmiddle nem de Windows.

      O núcleo determinístico sem I/O (parser DSL→JSON, schema, catálogo de funções, catálogo
      GUID→XPath, MapperVo) foi extraído para XslSynth.Contracts (design
      docs/architecture/design-xslsynth-runtime-e-reversibilidade-2026-08-16.md §1) — este
      projeto continua com o lado generativo (Ollama, RAG/FewShot, XSD validator, diff canônico,
      RepairOrchestrator) e referencia Contracts em vez de conter essas classes.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XslSynth.Contracts\XslSynth.Contracts.csproj" />
  </ItemGroup>

</Project>
