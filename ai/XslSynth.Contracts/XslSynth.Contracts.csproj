<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>XslSynth.Contracts</AssemblyName>
    <!-- Números/comparações XPath independem de cultura (mesma config do XslSynth.Core). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Núcleo determinístico e sem I/O externo extraído de ai/XslSynth.Core (design
      docs/architecture/design-xslsynth-runtime-e-reversibilidade-2026-08-16.md §1): parser
      DSL Sysmiddle → JSON estruturado (Camadas 0-1), catálogo de funções (Camada 2) e catálogo
      GUID→XPath. Referenciado tanto por ai/XslSynth.Core (que mantém o lado generativo — Ollama,
      RAG, XSD validator, RepairOrchestrator) quanto por Services/ da API (runtime, sem Ollama).
      Zero dependência de HTTP/Ollama/cripto Sysmiddle — só reflection-only (MetadataLoadContext)
      sobre metadata pública, não executa o assembly.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- FunctionCatalog.cs (Camada 2): reflection-only (MetadataLoadContext) sobre
         SysMiddle.ConnectUs.Functions.dll — lê metadata pública, NÃO executa o assembly. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>

</Project>
